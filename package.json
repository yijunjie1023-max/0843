{
  "name": "gamefit-duo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next node_modules/.cache",
    "dev": "bash -c 'ulimit -n 10240 2>/dev/null || true; exec env PORT=3040 ./node_modules/.bin/next dev -p 3040 -H 0.0.0.0'",
    "dev:clean": "bash scripts/dev-force.sh",
    "build": "next build",
    "build:static": "NEXT_STATIC_EXPORT=1 next build",
    "start": "next start",
    "start:lan": "next start -H 0.0.0.0",
    "lint": "next lint"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "next": "14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0"
  }
}
